# 1) Make a copy of this file named  .env.local  (same folder).
# 2) Paste your keys after the = signs. Never share .env.local or commit it.

# Stripe > Developers > API keys > "Secret key" (starts with sk_test_)
# Even better: create a "Restricted key" (rk_test_) with write access to Checkout Sessions.
STRIPE_SECRET_KEY=

# Printed by:  stripe listen --forward-to localhost:3000/api/webhooks/stripe   (starts with whsec_)
STRIPE_WEBHOOK_SECRET=

# Your app's name, shown in the header
NEXT_PUBLIC_APP_NAME=Couchette

# Your email: sent to Transitous (the free train-timetable service) so they can reach you if needed
TRANSITOUS_CONTACT=
